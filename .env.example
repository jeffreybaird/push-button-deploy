# Copy to .env (gitignored) next to bootstrap.sh — it is sourced automatically
# and overrides the calling shell's environment. Keep it private: chmod 600 .env
#
# This is the BOOTSTRAP credentials file. (The app's runtime .env on the
# droplet is a different file, generated by the deploy workflow.)

# ---- required ----------------------------------------------------------------
# ...for a SERVICE (the default app type): an app on its own droplet. The
# droplet-free types — APP_TYPE=cli / library, i.e. ./bootstrap.sh --cli or
# --no-droplet — provision nothing and require NONE of the eight below. They
# need the code host and nothing else, so a .env for one can be empty (or hold
# only the GITEA_* block).
DIGITALOCEAN_ACCESS_TOKEN="dop_v1_..."   # DO API token (write access)
DNSIMPLE_TOKEN="dnsimple_u_..."          # DNSimple API token
DNSIMPLE_ACCOUNT="12345"                 # DNSimple account id
DNS_ZONE="example.com"                   # zone the record is created in
SSH_KEY_NAME="my-key"                    # name of the SSH key in DO
SSH_PRIVATE_KEY="$HOME/.ssh/id_ed25519"  # path to the matching private key
SPACES_ACCESS_KEY_ID="..."               # Spaces keypair (Terraform state bucket)
SPACES_SECRET_ACCESS_KEY="..."

# ---- optional (defaults shown in README) ---------------------------------------
# GIT_PROVIDER="gitea"        # "github" (default) or "gitea" (self-hosted). See
#                             # "Gitea support" in the README. The four vars
#                             # below are required (except GITEA_OWNER) only
#                             # when GIT_PROVIDER=gitea.
# GITEA_URL="https://git.example.com"      # base URL of the instance
# GITEA_TOKEN="..."                        # personal access token (repo
#                                           # create/delete, Actions secrets/vars)
# GITEA_OWNER="myorg"                      # optional: create the repo under
#                                           # this user/org instead of whichever
#                                           # account GITEA_TOKEN authenticates as
# GITEA_RUNNER_IP="203.0.113.9/32"         # EGRESS IP/CIDR of the self-hosted
#                                           # Actions runner, allow-listed once
#                                           # in Terraform (no per-run firewall
#                                           # punch, unlike the GitHub path)
# APP_TYPE="cli"              # "service" (default) an app on a droplet; "cli" a
#                             # command-line program; "library" a reusable
#                             # package. The last two provision NOTHING — no
#                             # droplet, DNS, database or registry — and are
#                             # better passed per-run (--cli, --no-droplet) than
#                             # set here, since this file is shared across
#                             # projects. ./bootstrap.sh --help lists them all.
# LANGUAGE="ruby"             # the language WITHIN the app type — the same
#                             # choice `--cli ruby` and `--lang ruby` make.
#                             # service: "elixir" (default), "ruby", "static".
#                             # cli: "elixir" (default), "ruby", "bash",
#                             # "typescript". library: "elixir".
# FRAMEWORK="zola"            # the stack within the app type, by name rather
#                             # than by language; unique across types, so naming
#                             # one also picks the type. service: "phoenix"
#                             # (default), "sinatra", or "zola" (a static site:
#                             # no database, no image, no registry).
#                             # cli: "escript" (default), "ruby-cli",
#                             # "bash-cli", "ts-cli". library: "mix".
# DATABASE_BACKEND="postgres" # "postgres" (managed cluster) or "sqlite"
#                             # (on-droplet SQLite file, replicated to Spaces by
#                             # Litestream). Chosen once per project; don't flip it.
# HOST_APP_DIR="$HOME/src/myapp"
#                             # TENANT MODE: deploy onto the droplet this OTHER
#                             # app already owns instead of provisioning one.
#                             # Same as passing --host. SQLite or static only.
#                             # Better passed per-run than set here, since it
#                             # applies to whichever app you bootstrap next.
# PROJECT_NAME="myapp"        # infra naming — IMMUTABLE after first apply
# REGION="nyc3"
# DNS_RECORD="myapp"          # subdomain; "@" for the apex
# ENABLE_STAGING="false"      # "true" (default) gives the app a PR staging
#                             # environment at <DNS_RECORD>-stg.<DNS_ZONE>,
#                             # built when a PR opens and destroyed when it
#                             # closes. Never applies to a static site, and not
#                             # yet to GIT_PROVIDER=gitea (no staging workflow
#                             # for Gitea Actions — see README, Gitea support).
# SSH_CIDRS='["1.2.3.4/32"]'
# DOCR_REGISTRY="myapp"
# STATE_BUCKET="myapp-tfstate"
# SPACES_REGION="nyc3"
# LIVE_TIMEOUT_SECS="900"

# ---- bootstrap-gitea.sh only (provisions the Gitea instance itself) -------------
# This same .env covers both scripts. Full list + defaults: bootstrap-gitea.sh's
# header comment. The one REQUIRED addition for that script:
# GITEA_ADMIN_EMAIL="you@example.com"
# GITEA_ADMIN_USER="gitea-admin"  # NOT "admin" — Gitea reserves that name
#                                 # (also api, user, org, explore, ...)
# GITEA_DNS_RECORD="git"       # -> git.example.com. Deliberately separate from
#                               # DNS_RECORD (an app's own subdomain) so this one
#                               # shared .env can't collide the two.
# GITEA_PROJECT_NAME="gitea-infra"
# GITEA_REGION="nyc3"
# GITEA_DROPLET_SIZE="s-1vcpu-1gb"  # sized for zola CI. Bump for heavier
#                                   # builds: sinatra ~s-1vcpu-2gb, phoenix
#                                   # ~s-2vcpu-4gb. Up is a painless resize,
#                                   # down is not (see infra-gitea/main.tf).
# GITEA_DATA_VOLUME_GB="40"
