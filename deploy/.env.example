# Template for the .env the deploy writes over SSH (story 5.2). PLACEHOLDERS ONLY
# — never commit real secrets. The real .env is gitignored and lives only on the
# droplet. Consumed by compose.yaml interpolation + the app's runtime.exs.

# Full image reference, SHA-pinned by CI (story 5.1).
IMAGE=registry.digitalocean.com/<registry>/<app>:<git-sha>

# Public FQDN — must match the DNSimple A record and the cert Caddy issues.
DOMAIN=app.example.com

# ecto:// URL over the private VPC host (terraform output -raw database_url).
DATABASE_URL=ecto://user:pass@private-host:25060/dbname

# Phoenix secret (mix phx.gen.secret).
SECRET_KEY_BASE=replace-with-64-byte-secret

# Optional:
# POOL_SIZE=10
# ECTO_IPV6=false
# DNS_CLUSTER_QUERY=
