.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log
*.tfvars
!*.tfvars.example
.env

# Backend pointer written by bootstrap (bucket name + endpoint)
backend.hcl

infra-app/terraform.tfvars.bak
infra-persistent/terraform.tfvars.bak
bootstrap.log
teardown.log
terraform.tfvars.bak

# bootstrap-gitea.sh's cached admin credentials (generated once; re-run reuses
# them rather than regenerating — Gitea only shows a token/password at
# creation time, so losing this file means creating a new one by hand).
.gitea-admin-token
.gitea-admin-password