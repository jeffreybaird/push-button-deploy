.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log
*.tfvars
!*.tfvars.example
.env

# Backend pointer written by bootstrap (bucket name + endpoint)
backend.hcl

infra-app/terraform.tfvars.bak
infra-persistent/terraform.tfvars.bak
terraform.tfvars.bak

# Run transcripts and cached credentials now live in the state directory
# ($XDG_STATE_HOME/pbd, or PBD_STATE_DIR — `pbd config` prints it), outside any
# checkout. These entries cover the copies a pre-CLI checkout still has: the
# logs, and the Gitea admin credentials, which are generated once and shown by
# Gitea only at creation time. A run moves the credentials into the state
# directory rather than minting a second admin account.
bootstrap.log
bootstrap-gitea.log
teardown.log
.gitea-admin-token
.gitea-admin-password