# Copied into the generated app root alongside the Dockerfile.
_build/
deps/
.git/
.gitignore
.elixir_ls/
.fetch
# Compiled artifacts / archives
*.ez
*.tar
# Build-time + dev secrets must never enter the image (runtime env arrives via .env)
.env
# Test + dev cruft
/test
/tmp
# Asset build inputs are rebuilt in-image; keep node_modules out
assets/node_modules/
# Generated digested assets (mix assets.deploy regenerates them)
priv/static/assets/
priv/static/cache_manifest.json
